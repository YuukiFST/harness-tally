{
  "scenario": "opencode-trailing-slash",
  "arm": "opencode",
  "command": [
    "opencode.cmd",
    "run",
    "--format",
    "json",
    "--dir",
    "C:\\tmp\\hbwire-sandbox\\opencode-trailing-slash\\ws",
    "--pure",
    "-m",
    "mockollama/MOCK-2.6B",
    "--dangerously-skip-permissions",
    "Read hello.txt and reply with its first line."
  ],
  "env_tags": {
    "HB_RUN_ID": "run-0001",
    "HB_UNIT_ID": "unit-01"
  },
  "extra_env": {},
  "pi_settings": null,
  "exit_code": 0,
  "wall_s": 7.35,
