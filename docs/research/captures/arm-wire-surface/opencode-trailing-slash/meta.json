  "provider_config": {
    "$schema": "https://opencode.ai/config.json",
    "provider": {
      "mockollama": {
        "npm": "@ai-sdk/openai-compatible",
        "name": "Wire mock",
        "options": {
          "baseURL": "http://127.0.0.1:61448/v1/",
          "apiKey": "layer1",
          "timeout": 120000,
          "chunkTimeout": 60000
        },
        "models": {
          "MOCK-2.6B": {
            "limit": {
              "context": 32768,
              "output": 4096
            }
          }
        }
      }
